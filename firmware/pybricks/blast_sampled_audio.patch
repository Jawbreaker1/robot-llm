+/**
+ * Plays one little-endian byte buffer of unsigned 16-bit PCM samples.
+ *
+ * The low-level sound driver uses one-shot DMA, so wait=False returns while
+ * the transfer continues independently of the Python command loop.
+ */
+static mp_obj_t pb_type_Speaker_play_samples(size_t n_args, const mp_obj_t *pos_args, mp_map_t *kw_args) {
+    PB_PARSE_ARGS_METHOD(n_args, pos_args, kw_args,
+        pb_type_Speaker_obj_t, self,
+        PB_ARG_REQUIRED(samples),
+        PB_ARG_DEFAULT_INT(sample_rate, 8000),
+        PB_ARG_DEFAULT_NONE(sample_count),
+        PB_ARG_DEFAULT_TRUE(wait));
+
+    mp_int_t sample_rate = pb_obj_get_int(sample_rate_in);
+    if (sample_rate < 1000 || sample_rate > 48000) {
+        mp_raise_ValueError(MP_ERROR_TEXT("sample_rate must be 1000..48000"));
+    }
+
+    mp_buffer_info_t sample_buffer;
+    if (!mp_obj_is_type(samples_in, &mp_type_bytes) && !mp_obj_is_type(samples_in, &mp_type_bytearray)) {
+        mp_raise_TypeError(MP_ERROR_TEXT("samples must be bytes or bytearray u16le"));
+    }
+    mp_get_buffer_raise(samples_in, &sample_buffer, MP_BUFFER_READ);
+    if (sample_buffer.len % sizeof(uint16_t)) {
+        mp_raise_ValueError(MP_ERROR_TEXT("samples length must be even"));
+    }
+    if ((uintptr_t)sample_buffer.buf % sizeof(uint16_t)) {
+        mp_raise_ValueError(MP_ERROR_TEXT("samples must be 16-bit aligned"));
+    }
+
+    mp_int_t buffer_sample_count = sample_buffer.len / sizeof(uint16_t);
+    mp_int_t sample_count = sample_count_in == mp_const_none
+        ? buffer_sample_count
+        : pb_obj_get_int(sample_count_in);
+    if (sample_count < 1 || sample_count > buffer_sample_count) {
+        mp_raise_ValueError(MP_ERROR_TEXT("sample_count out of range"));
+    }
+    // STM32 DMA NDTR is 16-bit, so one transfer cannot exceed 65535 samples.
+    if (sample_count > UINT16_MAX) {
+        mp_raise_ValueError(MP_ERROR_TEXT("too many samples"));
+    }
+
+    self->sample_data = samples_in;
+    pbdrv_sound_start_once(sample_buffer.buf, (uint32_t)sample_count, sample_rate);
+
+    if (!mp_obj_is_true(wait_in)) {
+        pb_type_async_schedule_stop_iteration(self->iter);
+        return mp_const_none;
+    }
+
+    pb_type_async_t config = {
+        .parent_obj = MP_OBJ_FROM_PTR(self),
+        .iter_once = pb_type_Speaker_play_samples_iterate_once,
+        .close = pb_type_Speaker_close,
+    };
+    // New operation always wins; ongoing sound awaitable is cancelled.
+    return pb_type_async_wait_or_await(&config, &self->iter, true);
+}
+static MP_DEFINE_CONST_FUN_OBJ_KW(pb_type_Speaker_play_samples_obj, 1, pb_type_Speaker_play_samples);
