+static mp_obj_t pb_type_Speaker_done(mp_obj_t self_in) {
+    pb_type_Speaker_obj_t *self = MP_OBJ_TO_PTR(self_in);
+    bool done = !pbdrv_sound_is_active();
+    if (done) {
+        pbdrv_sound_stop();
+        self->sample_data = mp_const_none;
+    }
+    return mp_obj_new_bool(done);
+}
+static MP_DEFINE_CONST_FUN_OBJ_1(pb_type_Speaker_done_obj, pb_type_Speaker_done);
+
+static mp_obj_t pb_type_Speaker_stop(mp_obj_t self_in) {
+    return pb_type_Speaker_close(self_in);
+}
